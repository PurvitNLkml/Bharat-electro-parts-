# BharatElectroParts
# Leave the Supabase variables empty to run in demo mode. The app then uses
# seeded data held in server memory so the portals can be previewed before a
# Supabase project exists.

# Project URL from Supabase → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (new projects) or the anon key (older projects). Either one.
# This key is public. Never put the service role here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Do not prefix with NEXT_PUBLIC_. The app does not need this for
# ordinary reads and writes; row level security uses the signed-in user.
# Keep it for SQL maintenance and storage scripts you run yourself.
SUPABASE_SERVICE_ROLE_KEY=

# HMAC secret for demo-mode session cookies and demo file links.
# Demo mode is a preview, not production authentication.
DEMO_SESSION_SECRET=
